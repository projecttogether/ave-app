{
  "version": "2026-10-28.1",
  "precision": 32,
  "displayDecimals": 2,
  "rounding": "half-away-from-zero",
  "selection": "explicit-quarter-periods; exclusive-quarterly-per-kitchen-year; legacy-monthly-preferred-per-kitchen-year-indicator",
  "missing": "all-numerators-blank-excludes-row; partial-blanks-count-as-zero",
  "baseline": "configured-positive-annual-only; prorate-each-kitchen-by-its-measured-months; exclude-unmatched-kitchens-from-both-reduction-totals",
  "scoring": "round-per-kitchen-then-round-mean; blanks-count-in-maximum",
  "indicators": [
    {
      "id": "plant_based",
      "order": 1,
      "name": "Pflanzliche Lebensmittel",
      "shortName": "Pflanzl. LM",
      "target": 75,
      "unit": "%"
    },
    {
      "id": "organic",
      "order": 2,
      "name": "Ökologische Lebensmittel",
      "shortName": "Ökolog. LM",
      "target": 40,
      "unit": "%"
    },
    {
      "id": "food_waste",
      "order": 3,
      "name": "Lebensmittelabfälle",
      "shortName": "Food Waste",
      "target": -30,
      "unit": "%"
    },
    {
      "id": "seasonal",
      "order": 4,
      "name": "Saisonale Lebensmittel",
      "shortName": "Saisonalität",
      "target": 60,
      "unit": "Pkt."
    },
    {
      "id": "regional",
      "order": 5,
      "name": "Regionale Lebensmittel",
      "shortName": "Regionalität",
      "target": 20,
      "unit": "Pkt."
    },
    {
      "id": "fair_trade",
      "order": 6,
      "name": "Faire Beziehungen",
      "shortName": "Faire Bezieh.",
      "target": 90,
      "unit": "%"
    },
    {
      "id": "guest_satisfaction",
      "order": 7,
      "name": "Gästezufriedenheit",
      "shortName": "Gästezufried.",
      "target": 75,
      "unit": "Pkt."
    }
  ],
  "formulas": {
    "total_spend": {
      "title": "Gesamteinkauf Lebensmittel",
      "description": "Gesamtausgaben für Lebensmitteleinkäufe.",
      "unit": "€",
      "column": "totalFoodSpend"
    },
    "plant_based_percentage": {
      "title": "Pflanzliche Lebensmittel",
      "description": "Anteil der Lebensmittelausgaben für pflanzliche Produkte.",
      "unit": "%",
      "computed": true,
      "calculation": "inverse_sum",
      "spendColumns": [
        "meatSpend",
        "fishSpend",
        "dairySpend",
        "eggSpend",
        "mixedProductSpend"
      ],
      "weights": {
        "mixedProductSpend": 0.5
      }
    },
    "organic_percentage": {
      "title": "Ökologische Lebensmittel",
      "description": "Anteil der Lebensmittelausgaben für ökologische Produkte.",
      "unit": "%",
      "column": "organicSpend",
      "computed": true,
      "spendColumn": "organicSpend"
    },
    "fair_trade_percentage": {
      "title": "Faire Beziehungen",
      "description": "Anteil der Lebensmittelausgaben für Fair-Trade-Produkte.",
      "unit": "%",
      "computed": true,
      "spendColumns": [
        "fairTradeBananasSpend",
        "fairTradeCocoaSpend",
        "fairTradeCoffeeSpend",
        "fairTradeCocoaMixedSpend"
      ],
      "denominatorColumns": [
        "bananasSpend",
        "cocoaSpend",
        "coffeeSpend",
        "cocoaMixedSpend"
      ],
      "weights": {
        "fairTradeCocoaMixedSpend": 0.5,
        "cocoaMixedSpend": 0.5
      }
    },
    "regional_score": {
      "title": "Regionale Lebensmittel",
      "description": "Score der Aktivitäten für regionale Beschaffung.",
      "unit": "Pkt.",
      "column": "regionalScoringResult"
    },
    "seasonal_score": {
      "title": "Saisonale Lebensmittel",
      "description": "Score der Aktivitäten für saisonale Beschaffung.",
      "unit": "Pkt.",
      "column": "seasonalScoringResult"
    },
    "guest_satisfaction": {
      "title": "Gästezufriedenheit",
      "description": "Score der Aktivitäten zur Gästezufriedenheit.",
      "unit": "Pkt.",
      "column": "guestSatisfactionScoringResult"
    },
    "food_waste": {
      "title": "Lebensmittelabfälle",
      "description": "Gesamte Lebensmittelabfälle.",
      "unit": "%",
      "column": "foodWasteAmount"
    }
  },
